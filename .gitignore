# Build scratch: Mesa checkout, NDK, meson/ninja output, packaged ZIPs.
# Everything here is reproducible from build_turnip.sh and must never be
# committed -- the previous revision tracked tu_gen8*.patch by accident.
turnip_workdir/
workdir/

# Build and compilation artifacts
build/
out/
target/
bin/
dist/

# Meson and Ninja specific
.ninja_deps
.ninja_log
compile_commands.json
meson-logs/
meson-private/

# Downloaded source code and NDKs
mesa/
android-ndk-*/
ndk/

# Archives, binaries, and packages
*.zip
*.tar.gz
*.tar.xz
*.7z
*.so
*.apk

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/
venv/
.venv/

# IDE and system specific
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Environment and secrets
.env
local.properties
*.log